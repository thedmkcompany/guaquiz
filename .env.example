# ==================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==================================================
# Copy this file to .env.local and fill in values
# Never commit .env.local to version control
# ==================================================

# --------------------------------------------------
# WIX CRM CONFIGURATION
# --------------------------------------------------

# Wix API Key (from API Keys Manager: https://manage.wix.com/account/api-keys)
# Required permissions: Manage Contacts, Manage Members, Manage Pricing Plan Orders
WIX_API_KEY=

# Wix Site ID (found in dashboard URL or API Keys Manager)
WIX_SITE_ID=

# Wix Client ID (optional - for OAuth flow if using Wix checkout)
# Get from Wix Dashboard > Headless Settings > OAuth Apps
WIX_CLIENT_ID=

# Wix Automation Webhook URL (optional - for email triggers)
# Get this from: Wix Dashboard > Automations > Create Automation > When this happens: Custom Trigger > Set up trigger
# Format: https://manage.wix.com/_api/webhook-trigger/report/{trigger-id}/{site-id}
# Example: https://manage.wix.com/_api/webhook-trigger/report/a4feebe0-b74c-4805-8c40-592f657acb8e/a1f9ad24-1782-4815-af49-4248096d6544
WIX_AUTOMATION_WEBHOOK_URL=

# --------------------------------------------------
# WIX PRICING PLAN IDs (for CRM program assignment)
# --------------------------------------------------
# Get Plan IDs from Wix Dashboard > Pricing Plans > Edit Plan > URL
# These map to programs defined in src/lib/programs.ts
WIX_PLAN_ID_ESSENTIALS=
WIX_PLAN_ID_WEBINAR=
WIX_PLAN_ID_CIRCLE=
WIX_PLAN_ID_TRANSFORM_STRATEGY=
WIX_PLAN_ID_TRANSFORM=
WIX_PLAN_ID_DEFAULT=

# --------------------------------------------------
# RAZORPAY CONFIGURATION (Primary Payment Gateway)
# --------------------------------------------------
# Razorpay supports:
# - One-time payments
# - Subscriptions (recurring payments)
# - UPI, Cards, NetBanking, Wallets, EMI
# --------------------------------------------------

# Test Mode Keys (for development)
# Get from: https://dashboard.razorpay.com/app/keys
# Uncomment these for testing:
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Live Mode Keys (for production - requires KYC)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret (set when creating webhook in Razorpay dashboard)
# Dashboard > Account Settings > Webhooks > Add New Webhook
# Required events: payment.captured, payment.failed, subscription.*
RAZORPAY_WEBHOOK_SECRET=

# Public key (safe for client-side - must match RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --------------------------------------------------
# RAZORPAY PLAN IDs (for subscriptions)
# --------------------------------------------------
# Create Plans in Razorpay Dashboard > Subscriptions > Plans
# Only needed if programs have isSubscription: true
# Use NEXT_PUBLIC_ prefix for client-side subscription buttons
RAZORPAY_PLAN_ID_ESSENTIALS=
RAZORPAY_PLAN_ID_TRIAL=
RAZORPAY_PLAN_ID_CIRCLE=
RAZORPAY_PLAN_ID_TRANSFORM=

# Client-side subscription plan IDs (for landing page checkout buttons)
NEXT_PUBLIC_RAZORPAY_ESSENTIALS_PLAN_ID=
NEXT_PUBLIC_RAZORPAY_CIRCLE_PLAN_ID=
NEXT_PUBLIC_RAZORPAY_TRANSFORM_PLAN_ID=

# --------------------------------------------------
# RAZORPAY SUBSCRIPTION SETTINGS
# --------------------------------------------------
# UPI AutoPay: Maximum ₹15,000 per transaction for auto-debit without OTP
# Cards: First payment requires 3D Secure, then auto-debit
# Registration links expire after 30 days by default

# Enable subscription registration links (recommended for UPI/card mandates)
# Set to true to use registration link flow for proper mandate setup
RAZORPAY_USE_REGISTRATION_LINKS=false

# Default subscription billing cycles
RAZORPAY_DEFAULT_BILLING_CYCLES=12

# Maximum UPI mandate amount (cannot exceed ₹15,000)
RAZORPAY_UPI_MAX_AMOUNT=15000

# --------------------------------------------------
# PAYUMONEY CONFIGURATION (Backup Payment Gateway)
# --------------------------------------------------
# PayU is used as backup if Razorpay fails
# Note: PayU recurring payments require Standing Instructions (SI)
# --------------------------------------------------

# Test credentials (for development)
# PAYU_MERCHANT_KEY=
# PAYU_SALT=

# Live credentials (requires KYC with PayU)
PAYU_MERCHANT_KEY=
PAYU_SALT=

# Custom webhook authorization header
# Set this to any secret value, then configure same value in PayU dashboard
PAYU_WEBHOOK_SECRET=

# --------------------------------------------------
# ANALYTICS
# --------------------------------------------------

# Google Tag Manager - Client-side container (format: GTM-XXXXXXX)
# Get from: https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=

# Google Tag Manager - Server-side container (format: GTM-XXXXXXX)
# Used for server-side tagging (improved data accuracy & privacy)
NEXT_PUBLIC_GTM_SERVER_ID=

# --------------------------------------------------
# SUPABASE (Lead Queue & Backup Storage)
# --------------------------------------------------
# Supabase is used to reliably store quiz leads before syncing to Wix
# This ensures no leads are lost if Wix CRM is temporarily unavailable

# Supabase Project URL (format: https://[project-ref].supabase.co)
SUPABASE_URL=

# Supabase Service Role Key (server-side only - has write access)
# Get from: Project Settings > API > service_role key
# WARNING: Never expose this on client-side
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Anon Key (optional - for client-side if needed)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cron Secret (for retry-sync endpoint authentication)
# Generate a random string: openssl rand -hex 32
CRON_SECRET=

# --------------------------------------------------
# UPSTASH REDIS (Rate Limiting & Event Deduplication)
# --------------------------------------------------
# Redis is used for distributed rate limiting and webhook event deduplication
# across serverless instances. Free tier available at upstash.com

# Upstash Redis REST URL (format: https://[name]-[id].upstash.io)
# Get from: Upstash Console > Database > REST API > UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST Token
# Get from: Upstash Console > Database > REST API > UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------------
# APPLICATION SETTINGS
# --------------------------------------------------

# App URL (no trailing slash)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# --------------------------------------------------
# ADMIN DASHBOARD (for /admin/sync-status)
# --------------------------------------------------
# Basic auth credentials for admin dashboard
# Generate a strong password: openssl rand -base64 24
ADMIN_USER=admin
ADMIN_PASSWORD=

# --------------------------------------------------
# CALENDLY (for high-ticket booking)
# --------------------------------------------------
# Used for Transform program (requiresCall: true)
CALENDLY_URL_TRANSFORM=

# --------------------------------------------------
# AISENSY (WhatsApp Marketing & Automation)
# --------------------------------------------------
# AISensy enables automated WhatsApp messaging after quiz completion
# and payment. Contacts are automatically created when sending campaigns.
# API Documentation: https://wiki.aisensy.com/en/articles/11501889-api-reference-docs

# AISensy API Key
# Get from: AISensy Dashboard > Manage > API Key
AISENSY_API_KEY=

# AISensy Base URL (default: https://backend.aisensy.com)
AISENSY_BASE_URL=https://backend.aisensy.com

# Enable/disable AISensy integration
NEXT_PUBLIC_AISENSY_ENABLED=false

# Campaign Names (must be LIVE campaigns created in AISensy dashboard)
# Steps to create campaigns:
# 1. Create WhatsApp templates in AISensy
# 2. Submit templates for WhatsApp approval (24-48 hours)
# 3. Create campaigns using approved templates
# 4. Set campaigns to LIVE status
# 5. Copy exact campaign names here

# --------------------------------------------------
# AISENSY WHATSAPP CAMPAIGNS (Program-Specific)
# --------------------------------------------------
# Campaign Names must match LIVE campaigns in AISensy dashboard
# Steps: Create template → Get WhatsApp approval → Create campaign → Set to LIVE
# Copy exact campaign name from AISensy dashboard

# Quiz Welcome Campaigns (sent after quiz completion with personalized results)
AISENSY_CAMPAIGN_QUIZ_RESULTS_CIRCLE=
AISENSY_CAMPAIGN_QUIZ_RESULTS_TRANSFORM=
AISENSY_CAMPAIGN_QUIZ_RESULTS_ESSENTIALS=
AISENSY_CAMPAIGN_QUIZ_RESULTS_WEBINAR=
AISENSY_CAMPAIGN_QUIZ_RESULTS_STRATEGY=

# Payment Confirmation Campaigns (sent after successful payment)
AISENSY_CAMPAIGN_WEBINAR=
AISENSY_CAMPAIGN_TRANSFORM=
AISENSY_CAMPAIGN_CIRCLE=
AISENSY_CAMPAIGN_ESSENTIALS_1ST=        # For 1st of month start
AISENSY_CAMPAIGN_ESSENTIALS_15TH=       # For 15th of month start
AISENSY_CAMPAIGN_STRATEGY=

# Generic Campaigns (fallback if program-specific not set)
AISENSY_CAMPAIGN_WELCOME=               # Generic welcome message
AISENSY_CAMPAIGN_PAYMENT_SUCCESS=       # Generic payment confirmation
AISENSY_CAMPAIGN_PROGRAM_START=         # Program start reminder

# --------------------------------------------------
# SETUP CHECKLIST
# --------------------------------------------------
# 1. Razorpay:
#    [ ] Create account at razorpay.com
#    [ ] Complete KYC for live payments
#    [ ] Generate API keys (test first, then live)
#    [ ] Create webhook with URL: {APP_URL}/api/webhooks/razorpay
#    [ ] For subscriptions: Create Plans in dashboard
#
# 2. PayU (optional backup):
#    [ ] Create account at payu.in
#    [ ] Complete KYC
#    [ ] Get Merchant Key and Salt
#    [ ] Configure webhook URL: {APP_URL}/api/webhooks/payu
#
# 3. Wix CRM:
#    [ ] Create Wix account and site
#    [ ] Generate API key with required permissions
#    [ ] Create Pricing Plans for programs
#    [ ] Set up Automations for welcome emails
#    [ ] (Optional) Create webhook trigger for emails
#
# 4. AISensy (optional - for WhatsApp automation):
#    [ ] Create account at app.aisensy.com
#    [ ] Complete WhatsApp Business API verification
#    [ ] Generate API key (Manage > API Key)
#    [ ] Create message templates for each program
#    [ ] Submit templates for WhatsApp approval (24-48 hours)
#    [ ] Create campaigns from approved templates
#    [ ] Set campaigns to LIVE status
#    [ ] Copy exact campaign names to env vars above
#    [ ] Set NEXT_PUBLIC_AISENSY_ENABLED=true
#    [ ] Test each campaign with real phone number
#
# 5. Deploy:
#    [ ] Add all env vars to hosting platform
#    [ ] Update webhook URLs to production domain
#    [ ] Test with small real payment
#    [ ] Verify AISensy messages are delivered
# --------------------------------------------------
